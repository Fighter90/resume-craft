# =============================================================================
# ResumeCraft — Переменные окружения (ШАБЛОН)
# Скопируйте в .env и заполните реальными значениями
# НИКОГДА не коммитьте .env в Git!
# =============================================================================

# --- Общие ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://resumecraft:devpassword@localhost:5432/resumecraft
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth / Security ---
SECRET_KEY=change-me-to-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://localhost:8000"]

# --- LLM Providers ---
# GigaChat (developers.sber.ru)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenRouter (openrouter.ai) — мульти-провайдер (Claude, Gemini, Mistral и др.)
OPENROUTER_API_KEY=

# --- hh.ru API ---
HH_USER_AGENT=ResumeCraft/2.0 (contact@resumecraft.ru)

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- Flower (Celery мониторинг) ---
FLOWER_PORT=5555
